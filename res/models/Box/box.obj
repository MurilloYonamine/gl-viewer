# Textured cube for GL Viewer / LearnOpenGL

# Each face has full [0,1] UV range
o TexturedCube
s off

# Front face
v -0.500000 -0.500000 0.500000
v 0.500000 -0.500000 0.500000
v 0.500000 0.500000 0.500000
v -0.500000 0.500000 0.500000
vt 0.000000 0.000000
vt 1.000000 0.000000
vt 1.000000 1.000000
vt 0.000000 1.000000
vn 0.000000 0.000000 1.000000

# Back face
v 0.500000 -0.500000 -0.500000
v -0.500000 -0.500000 -0.500000
v -0.500000 0.500000 -0.500000
v 0.500000 0.500000 -0.500000
vt 0.000000 0.000000
vt 1.000000 0.000000
vt 1.000000 1.000000
vt 0.000000 1.000000
vn 0.000000 0.000000 -1.000000

# Right face
v 0.500000 -0.500000 0.500000
v 0.500000 -0.500000 -0.500000
v 0.500000 0.500000 -0.500000
v 0.500000 0.500000 0.500000
vt 0.000000 0.000000
vt 1.000000 0.000000
vt 1.000000 1.000000
vt 0.000000 1.000000
vn 1.000000 0.000000 0.000000

# Left face
v -0.500000 -0.500000 -0.500000
v -0.500000 -0.500000 0.500000
v -0.500000 0.500000 0.500000
v -0.500000 0.500000 -0.500000
vt 0.000000 0.000000
vt 1.000000 0.000000
vt 1.000000 1.000000
vt 0.000000 1.000000
vn -1.000000 0.000000 0.000000

# Top face
v -0.500000 0.500000 0.500000
v 0.500000 0.500000 0.500000
v 0.500000 0.500000 -0.500000
v -0.500000 0.500000 -0.500000
vt 0.000000 0.000000
vt 1.000000 0.000000
vt 1.000000 1.000000
vt 0.000000 1.000000
vn 0.000000 1.000000 0.000000

# Bottom face
v -0.500000 -0.500000 -0.500000
v 0.500000 -0.500000 -0.500000
v 0.500000 -0.500000 0.500000
v -0.500000 -0.500000 0.500000
vt 0.000000 0.000000
vt 1.000000 0.000000
vt 1.000000 1.000000
vt 0.000000 1.000000
vn 0.000000 -1.000000 0.000000

g Front
f 1/1/1 2/2/1 3/3/1
f 1/1/1 3/3/1 4/4/1

g Back
f 5/5/2 6/6/2 7/7/2
f 5/5/2 7/7/2 8/8/2

g Right
f 9/9/3 10/10/3 11/11/3
f 9/9/3 11/11/3 12/12/3

g Left
f 13/13/4 14/14/4 15/15/4
f 13/13/4 15/15/4 16/16/4

g Top
f 17/17/5 18/18/5 19/19/5
f 17/17/5 19/19/5 20/20/5

g Bottom
f 21/21/6 22/22/6 23/23/6
f 21/21/6 23/23/6 24/24/6
